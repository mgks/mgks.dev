---
// Redirect /blog to /rollups/
const target = '/rollups/';
---
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>Redirecting to {target}</title>
    <link rel="canonical" href={`https://mgks.dev${target}`} />
    <meta http-equiv="refresh" content={`0;url=${target}`} />
    <meta name="robots" content="noindex" />
  </head>
  <body>
    <p>Redirecting to <a href={target}>{target}</a>...</p>
    <script is:inline>
      window.location.replace('/rollups/');
    </script>
  </body>
</html>
