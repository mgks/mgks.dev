---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { slugify } from '../../utils/slugs';

export async function getStaticPaths({ paginate }) {
  const posts = (await getCollection('blog', ({ data }) => {
    return data.date <= new Date(); 
  })).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

  return paginate(posts, { pageSize: 15 });
}

const { page } = Astro.props;
const isFirstPage = page.currentPage === 1;

// All posts sorted by date
const allPosts = (await getCollection('blog', ({ data }) => {
  return data.date <= new Date();
})).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

// Top 3 as visual preview (page 1 only)
const recentPosts = isFirstPage ? allPosts.slice(0, 3) : [];

// Tag Cloud Data (Exclude 'rollup' tag since all posts are rollups)
const rawTags = allPosts.flatMap(post => post.data.tags);
const tagCounts = rawTags.reduce((acc, tag) => { acc[tag] = (acc[tag] || 0) + 1; return acc; }, {});
const sortedTags = Object.keys(tagCounts).sort((a, b) => tagCounts[b] - tagCounts[a]);
const visibleTags = sortedTags.filter(t => t !== 'rollup').slice(0, 10);
const hiddenTags = sortedTags.filter(t => t !== 'rollup').slice(10);
---

<Layout title="Rollups" description="Automated digests, research breakdowns, technical notes, and developer insights.">

  <section class="page-hero">
    <h1 class="hero-title">Rollups<span class="text-accent">.</span></h1>
    <p class="hero-desc">Automated digests, research breakdowns, technical notes, and developer insights.</p>
  </section>

  <!-- Filter Bar -->
  <div class="filter-bar">
      <div class="container">
          <div class="filter-group">
              <a href="/rollups" class="filter-btn active">All</a>
              {visibleTags.map(tag => <a href={`/tags/${slugify(tag)}`} class="filter-btn">{tag}</a>)}
              {hiddenTags.length > 0 && (
                  <>
                    <div id="hidden-tags" class="filter-group hidden" style="display: contents;">
                        {hiddenTags.map(tag => <a href={`/tags/${slugify(tag)}`} class="filter-btn">{tag}</a>)}
                    </div>
                    <button id="tag-toggle-btn" class="tag-toggle-btn"><span id="tag-btn-text">+ More</span></button>
                  </>
              )}
          </div>
      </div>
  </div>

  <div class="container rollups-content">

    <!-- SECTION 1: RECENT 3 (Page 1 Only) — visual preview grid -->
    {isFirstPage && recentPosts.length > 0 && (
        <section class="rollups-preview">
             <div class="featured-grid">
                {/* Hero Post */}
                <a href={`/rollups/${recentPosts[0].id}`} class="group feat-hero feat-hero-flex">
                    <div class="feat-hero-img">
                        {recentPosts[0].data.image ? (
                            <img src={recentPosts[0].data.image} class="group-hover:scale-105 transition-transform duration-700 ease-out" />
                        ) : (
                            <div class="feat-hero-img-placeholder"></div>
                        )}
                        <div class="feat-hero-img-fade"></div>
                    </div>
                    <div class="feat-hero-body">
                        <time class="archive-date">{recentPosts[0].data.date.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}</time>
                        <h3 class="text-2xl font-bold mt-2 mb-2 leading-tight group-hover:text-accent transition-colors">{recentPosts[0].data.title}</h3>
                        <p class="text-sm text-muted line-clamp-2 leading-relaxed">
                            {recentPosts[0].data.description}
                        </p>
                    </div>
                </a>

                {/* Sub cards */}
                {recentPosts.length > 1 && recentPosts.slice(1).map(post => (
                    <a href={`/rollups/${post.id}`} class="feat-sub group">
                        <div class="flex items-center gap-3 text-xs font-mono text-muted mb-2">
                            <time class="archive-date">{post.data.date.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}</time>
                        </div>
                        <h3 class="text-xl font-bold mb-2 group-hover:text-accent transition-colors leading-tight">{post.data.title}</h3>
                        <p class="text-sm text-muted line-clamp-3 leading-relaxed">
                            {post.data.description}
                        </p>
                    </a>
                ))}
             </div>
        </section>
    )}

    <!-- SECTION 2: ARCHIVES (Paginated) -->
    <section class="project-section">
        <h2 class="project-section-title">
            {isFirstPage ? 'Latest Rollups' : `Page ${page.currentPage}`}
        </h2>
        <div class="archive-list">
            {page.data.map(post => (
                <a href={`/rollups/${post.id}`} class="archive-item">
                    <time class="archive-date">{post.data.date.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}</time>
                    <div class="archive-content">
                        <h3>{post.data.title}</h3>
                        {post.data.description && <p>{post.data.description}</p>}
                    </div>
                </a>
            ))}
        </div>
    </section>

    <!-- PAGINATION -->
    <div class="pagination">
        {page.url.prev ? <a href={page.url.prev} class="page-btn">&larr; Previous</a> : <span style="opacity: 0;">Prev</span>}
        <span class="text-muted" style="font-family: var(--font-mono); font-size: 0.9rem;">Page {page.currentPage} of {page.lastPage}</span>
        {page.url.next ? <a href={page.url.next} class="page-btn">Next &rarr;</a> : <span style="opacity: 0;">Next</span>}
    </div>

  </div>
</Layout>
